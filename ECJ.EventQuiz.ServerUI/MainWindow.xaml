<Window x:Class="ECJ.EventQuiz.ServerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ECJ EventQuiz"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Width="560"
        Height="500"
        MinWidth="560"
        MinHeight="500"
        MaxWidth="560"
        MaxHeight="500"
        Background="#152033"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56"
                        ResizeBorderThickness="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="#2A3D5C" BorderThickness="1" Background="#152033" CornerRadius="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar"
            Grid.Row="0"
            Background="#152033"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="10,0,8,0"
                    IsHitTestVisible="False">
          <Image Source="Assets/BrandLogo.png"
                 Height="36"
                 Margin="0,0,8,0"
                 Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 SnapsToDevicePixels="True" />
          <Image Source="Assets/BrandTitle.png"
                 Height="48"
                 MaxWidth="440"
                 Stretch="Uniform"
                 VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 SnapsToDevicePixels="True" />
        </StackPanel>

        <Button x:Name="SettingsButton"
                Grid.Column="1"
                Content="Indstillinger"
                Click="OnSettingsClick"
                Style="{StaticResource TitleBarTextButton}" />

        <StackPanel x:Name="CaptionButtons"
                    Grid.Column="2"
                    Orientation="Horizontal" />
      </Grid>

      <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
  </Border>
</Window>
